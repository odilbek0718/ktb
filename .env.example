# PostgreSQL ulanish manzili
# Localhost (docker-compose bilan): quyidagicha qoldiring
# Railway'da: Railway avtomatik DATABASE_URL beradi, buni qo'lda yozish shart emas
DATABASE_URL=postgresql://kutubxonam:kutubxonam123@localhost:5432/kutubxonam

# JWT token uchun maxfiy kalit - buni ALBATTA o'zgartiring (tasodifiy uzun matn kiriting)
JWT_SECRET=juda-maxfiy-kalit-buni-ozgartiring-123456789

# Server porti
PORT=3000

# Muhit turi (development / production)
NODE_ENV=development
